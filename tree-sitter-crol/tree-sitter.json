{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "crol",
      "camelcase": "Crol",
      "scope": "source.crol",
      "path": ".",
      "file-types": ["crod", "crol"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^crol$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT OR Apache-2.0",
    "description": "CROL, the Composable Rust Object Language",
    "links": {
      "repository": "https://github.com/DreamLogics/crol"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
