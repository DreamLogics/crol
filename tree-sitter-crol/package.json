{
  "name": "tree-sitter-crol",
  "version": "0.1.0",
  "description": "CROL, the Composable Rust Object Language: a tree-sitter grammar",
  "repository": "https://github.com/DreamLogics/crol",
  "license": "MIT OR Apache-2.0",
  "keywords": ["tree-sitter", "crol", "parser"],
  "files": ["grammar.js", "src/**", "queries/**", "tree-sitter.json"],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.25.10"
  },
  "tree-sitter": [
    {
      "scope": "source.crol",
      "file-types": ["crod", "crov"],
      "highlights": "queries/highlights.scm"
    }
  ]
}
