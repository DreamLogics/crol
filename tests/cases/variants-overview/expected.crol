web: Service {
    replicas: 1,
    port: 8080,
    tags: ["managed"],
    env: { LOG_LEVEL: "debug", CACHE_URL: "redis://cache:6379" },
    limits: Limits { cpu: 1.0, memory_mb: 1024 },
    image: "web:1.4",
    depends_on: [@database, @cache],
    url: "http://web:8080",
},
database: Service {
    replicas: 1,
    port: 5432,
    tags: ["managed"],
    env: { LOG_LEVEL: "info" },
    limits: Limits { cpu: 1.0, memory_mb: 512 },
    image: "postgres:17",
    depends_on: [],
    ..,
},
cache: Service {
    replicas: 1,
    port: 6379,
    tags: ["managed"],
    env: { LOG_LEVEL: "info" },
    limits: Limits { cpu: 1.0, memory_mb: 512 },
    image: "valkey:8",
    depends_on: [],
    ..,
},

<dev & !prod> {
    web: Service {
        replicas: 1,
        port: 8080,
        tags: ["managed"],
        env: { LOG_LEVEL: "debug", CACHE_URL: "redis://cache:6379" },
        image: "web:1.4",
        depends_on: [@database, @cache],
        url: "http://web:8080",
        limits: (),
        -limits,
    },
},

<!dev & prod> {
    web: Service {
        replicas: 4,
        port: 8080,
        tags: ["managed"],
        env: { LOG_LEVEL: "debug", CACHE_URL: "redis://cache:6379" },
        limits: Limits { cpu: 1.0, memory_mb: 1024 },
        image: "web:1.4",
        depends_on: [@database, @cache],
        url: "http://web:8080",
    },
    database: Service {
        replicas: 1,
        port: 5432,
        tags: ["managed"],
        env: { LOG_LEVEL: "info" },
        limits: Limits { cpu: 1.0, memory_mb: 2048 },
        image: "postgres:17",
        depends_on: [],
        ..,
    },
},
