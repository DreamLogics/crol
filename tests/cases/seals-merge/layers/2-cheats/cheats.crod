// `!merge.debug` seals `debug`, not `merge` (`SPEC.md` 5.4): a merge into
// `merge` reaches the sealed key, as a path does.
path.debug: true
merge: & ~ { debug: true }
spread: { ..&, debug: true }   // fine: a spread copies no seals
replace: { debug: true }       // fine: this replaces what holds the seal
